{
  "name": "Drivoo",
  "version": "3.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "concurrently -n web -c cyan \"npm:start\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox",
    "start:demo": "ng serve --configuration demo",
    "build": "ng build",
    "build:demo": "npm run mock:build && ng build --configuration demo",
    "build:prod": "ng build --configuration production",
    "mock:build": "node scripts/generate-mock-api.mjs"
  },
  "private": true,
  "dependencies": {
    "@amcharts/amcharts5": "^5.20.1",
    "@amcharts/amcharts5-geodata": "^5.1.6",
    "@angular-architects/module-federation": "^22.0.0",
    "@angular-architects/native-federation": "^22.2.3",
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-tabler-icons": "^3.26.0",
    "apexcharts": "^6.7.1",
    "es-module-shims": "^2.8.0",
    "iconify": "^1.4.0",
    "ng-apexcharts": "^3.0.0",
    "ngx-dropzone": "^3.1.0",
    "ngx-editor": "^19.0.0-beta.1",
    "ngx-scrollbar": "^18.0.0",
    "ngx-skeleton-loader": "^13.0.0",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.2",
    "sass": "^1.95.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "ua-parser-js": "^2.0.10",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.1"
